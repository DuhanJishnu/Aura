# Required: get a key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your-key-here

# Google ADK uses standard Gemini API (no Vertex AI / GCP billing required)
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Models (configurable to any model your Gemini API key supports)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_SEARCH_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_LIVE_VOICE=Aoede
GEMINI_THINKING=low

# Currency / locale context for online shopping search (default: India / INR)
DEFAULT_REGION=India
DEFAULT_CURRENCY=INR

# Free-tier deployment & safety
RATE_LIMIT_PER_MIN=60
TRUST_PROXY=0
ALLOWED_ORIGINS=*
PROFILE_STORE_DIR=data/profiles
