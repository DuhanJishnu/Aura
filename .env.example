GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-2.5-flash
# speed (see README "Performance")
GEMINI_THINKING=low
# GEMINI_FAST_MODEL=
# FASTPATH=1
# PHRASE_ALL=0
# deployment
# AUTO_SEED=1            build the catalog on first start (the Dockerfile sets this)
# RATE_LIMIT_PER_MIN=60  per client; 0 turns the limiter off
# TRUST_PROXY=1          read the client address from X-Forwarded-For (behind a load balancer)
# MAX_SESSIONS=5000      conversations kept in memory
