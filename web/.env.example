# Where the FastAPI backend runs (server-side proxy target for /api/*).
BACKEND_URL=http://127.0.0.1:8000

# Optional: public WebSocket URL for Gemini Live voice when deploying frontend & backend separately
# (e.g. Vercel frontend -> Render/HF Spaces backend: wss://your-api.onrender.com)
# NEXT_PUBLIC_WS_URL=
